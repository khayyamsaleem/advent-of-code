bazel_dep(name = "catch2", version = "3.11.0")
bazel_dep(name = "cpp-httplib", version = "0.22.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

# Only golang.org/x/sync/errgroup is needed, pulled in directly (no go.mod in
# this repo) via gazelle's go_deps extension.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.module(
    path = "golang.org/x/sync",
    sum = "h1:l60nONMj9l5drqw6jlhIELNv9I0A4OFgRsG9k2oT9Ug=",
    version = "v0.17.0",
)
use_repo(go_deps, "org_golang_x_sync")

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    # Bazel 9 removed native.py_binary and native.cc_binary; this fork adds the required loads.
    # Tracking: https://github.com/hedronvision/bazel-compile-commands-extractor/pull/272
    remote = "https://github.com/tinted-software/bazel-compile-commands-extractor.git",
    commit = "61f2d8f97cfcdcbf2f4ad504c1a093fbbe92ece2",
)

# Bazel 9 removed cc_library as a native rule, but the cpp-httplib BCR overlay
# BUILD file still uses it without a load(). This patch adds the missing load().
single_version_override(
    module_name = "cpp-httplib",
    patches = ["//patches:cpp-httplib.patch"],
    patch_strip = 1,
)

# boringssl was resolved to a snapshot (0.0.0-20240530-2db0eb3) whose
# crypto/internal.h unconditionally uses `_Generic` in public-facing
# headers, but `_Generic` is a C-only keyword that GCC rejects in C++
# mode. Bump to a newer snapshot that has the `__cplusplus` guard.
single_version_override(
    module_name = "boringssl",
    version = "0.20260813.0",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "dotenv_cpp",
    # Fetches the master branch. For production, replace with a specific commit hash/URL.
    url = "https://github.com/laserpants/dotenv-cpp/archive/refs/heads/master.tar.gz",
    strip_prefix = "dotenv-cpp-master",
    # Inject a BUILD file since the repo doesn't have one
    build_file_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "dotenv",
    hdrs = glob(["include/laserpants/dotenv/*.h"]),
    includes = ["include/laserpants/dotenv"],
    visibility = ["//visibility:public"],
)
""",
)
